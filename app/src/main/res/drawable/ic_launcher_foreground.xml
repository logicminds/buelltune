<?xml version="1.0" encoding="utf-8"?>
<!--
  BuellTune launcher icon - foreground layer.
  "Digital Wing" mark: a Pegasus neck/crest with four equalizer-style wing
  feathers (low-range to peak-RPM power bands) plus a telemetry circuit
  overlay (data-signal line, nodes, connection vectors), matching the
  supplied icon.svg master artwork 1:1 - same path geometry, same gradients.
  A <clip-path> reproduces icon.svg's own viewBox="60 30 230 180" crop (it
  intentionally truncates the neck's near tip and the circuit line's left
  tail), so this vector renders pixel-identical to the source SVG once
  scaled into the Adaptive Icon safe zone. The group's scale/translate fit
  the mark's actual painted-content bounding box after that crop (roughly
  x:60-243, y:46.5-179) into a centered 66dp square within the 108dp
  viewport (Adaptive Icon safe-zone spec), so the artwork is centered and
  fills the safe zone rather than sitting flush against the crop rect.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:scaleX="0.360656"
        android:scaleY="0.360656"
        android:translateX="-0.6393"
        android:translateY="13.3361">

        <clip-path android:pathData="M60,30 L290,30 L290,210 L60,210 Z" />

        <!-- Pegasus neck / crest, lower segment (Cast Iron / Frame) -->
        <path
            android:fillColor="#2A2E37"
            android:pathData="M 30,175 L 60,115 L 105,115 L 75,175 Z" />

        <!-- Pegasus neck / crest, upper segment (brushed-metal gradient) -->
        <path android:pathData="M 68,110 L 98,50 L 143,50 L 113,110 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="68" android:startY="50"
                    android:endX="143" android:endY="110">
                    <item android:offset="0" android:color="#F4F5F7" />
                    <item android:offset="0.5" android:color="#9AA0A6" />
                    <item android:offset="1" android:color="#4A505A" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Wing feather 1: low-range power (equalizer bar) -->
        <path android:pathData="M 82,175 L 112,115 L 132,115 L 102,175 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="82" android:startY="115"
                    android:endX="132" android:endY="175">
                    <item android:offset="0" android:color="#FF5500" />
                    <item android:offset="1" android:color="#FF2A00" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Wing feather 2: mid-range power / acceleration -->
        <path android:pathData="M 109,175 L 149,95 L 169,95 L 129,175 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="109" android:startY="95"
                    android:endX="169" android:endY="175">
                    <item android:offset="0" android:color="#FF5500" />
                    <item android:offset="1" android:color="#FF2A00" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Wing feather 3: peak-RPM / high-end data surge -->
        <path android:pathData="M 136,175 L 186,75 L 206,75 L 156,175 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="136" android:startY="75"
                    android:endX="206" android:endY="175">
                    <item android:offset="0" android:color="#FF5500" />
                    <item android:offset="1" android:color="#FF2A00" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Apex wingtip (max lift) -->
        <path
            android:fillColor="#FF7733"
            android:pathData="M 163,175 L 223,55 L 243,55 L 183,175 Z" />

        <!-- Telemetry horizon / data-signal line -->
        <path android:strokeWidth="3" android:strokeLineCap="round"
            android:pathData="M 20,175 L 210,175">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="20" android:startY="175"
                    android:endX="210" android:endY="175">
                    <item android:offset="0" android:color="#00E5FF" />
                    <item android:offset="1" android:color="#0088FF" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Telemetry nodes -->
        <path
            android:fillColor="#00E5FF"
            android:pathData="M 56,175 a4,4 0 1,0 8,0 a4,4 0 1,0 -8,0 Z" />
        <path
            android:fillColor="#00E5FF"
            android:pathData="M 102,115 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0 Z" />
        <path
            android:fillColor="#00E5FF"
            android:pathData="M 139.5,50 a3.5,3.5 0 1,0 7,0 a3.5,3.5 0 1,0 -7,0 Z" />
        <path
            android:fillColor="#00E5FF"
            android:pathData="M 219,55 a4,4 0 1,0 8,0 a4,4 0 1,0 -8,0 Z" />

        <!-- Connection vectors -->
        <path
            android:strokeColor="#00E5FF"
            android:strokeWidth="1.5"
            android:pathData="M 60,175 L 105,115" />
        <path
            android:strokeColor="#00E5FF"
            android:strokeWidth="1.5"
            android:pathData="M 105,115 L 143,50" />
    </group>
</vector>
