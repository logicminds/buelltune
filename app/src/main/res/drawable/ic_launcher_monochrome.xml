<?xml version="1.0" encoding="utf-8"?>
<!--
  BuellTune launcher icon - monochrome (Android 13+ themed-icon) layer.
  Same "Digital Wing" silhouette as ic_launcher_foreground.xml (identical
  geometry and clip-path crop), collapsed to a single fill/stroke color;
  the system substitutes its own themed color at render time.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:scaleX="0.360656"
        android:scaleY="0.360656"
        android:translateX="-0.6393"
        android:translateY="13.3361">

        <clip-path android:pathData="M60,30 L290,30 L290,210 L60,210 Z" />

        <!-- Neck / crest -->
        <path
            android:fillColor="#FF000000"
            android:pathData="M 30,175 L 60,115 L 105,115 L 75,175 Z" />
        <path
            android:fillColor="#FF000000"
            android:pathData="M 68,110 L 98,50 L 143,50 L 113,110 Z" />

        <!-- Wing feathers -->
        <path
            android:fillColor="#FF000000"
            android:pathData="M 82,175 L 112,115 L 132,115 L 102,175 Z" />
        <path
            android:fillColor="#FF000000"
            android:pathData="M 109,175 L 149,95 L 169,95 L 129,175 Z" />
        <path
            android:fillColor="#FF000000"
            android:pathData="M 136,175 L 186,75 L 206,75 L 156,175 Z" />
        <path
            android:fillColor="#FF000000"
            android:pathData="M 163,175 L 223,55 L 243,55 L 183,175 Z" />

        <!-- Telemetry horizon line -->
        <path
            android:strokeColor="#FF000000"
            android:strokeWidth="3"
            android:strokeLineCap="round"
            android:pathData="M 20,175 L 210,175" />

        <!-- Telemetry nodes -->
        <path
            android:fillColor="#FF000000"
            android:pathData="M 56,175 a4,4 0 1,0 8,0 a4,4 0 1,0 -8,0 Z" />
        <path
            android:fillColor="#FF000000"
            android:pathData="M 102,115 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0 Z" />
        <path
            android:fillColor="#FF000000"
            android:pathData="M 139.5,50 a3.5,3.5 0 1,0 7,0 a3.5,3.5 0 1,0 -7,0 Z" />
        <path
            android:fillColor="#FF000000"
            android:pathData="M 219,55 a4,4 0 1,0 8,0 a4,4 0 1,0 -8,0 Z" />

        <!-- Connection vectors -->
        <path
            android:strokeColor="#FF000000"
            android:strokeWidth="1.5"
            android:pathData="M 60,175 L 105,115" />
        <path
            android:strokeColor="#FF000000"
            android:strokeWidth="1.5"
            android:pathData="M 105,115 L 143,50" />
    </group>
</vector>
