<?xml version="1.0" encoding="utf-8"?>
<resources>
	<!-- BuellTune brand palette ("Digital Wing" identity), matched to the
	     adaptive-icon artwork (drawable/ic_launcher_foreground.xml). -->
	<color name="brand_primary_dark">#0F1115</color>    <!-- Midnight Asphalt -->
	<color name="brand_accent_flame">#FF4500</color>    <!-- Buell Racing Orange -->
	<color name="brand_data_blue">#00D2FF</color>       <!-- Telemetry / ECU Active State -->
	<color name="brand_text_primary">#F4F5F7</color>    <!-- Pure Aluminum -->
	<color name="brand_secondary_gray">#2A2E37</color>  <!-- Cast Iron / Frame -->

	<color name="colorPrimary">@color/brand_accent_flame</color>
	<color name="colorPrimaryDark">@color/brand_primary_dark</color>
	<color name="colorAccent">@color/brand_data_blue</color>

	<!-- Nav-drawer header gradient (side_nav_bar.xml): flame orange fading
	     through the icon's frame-gray into midnight-asphalt black, matching
	     the wing artwork's own flame-grad stops. -->
	<color name="nav_header_gradient_start">#FF5500</color>
	<color name="nav_header_gradient_center">@color/colorPrimary</color>
	<color name="nav_header_gradient_end">@color/colorPrimaryDark</color>

	<!-- Nav-drawer menu icon tint (activity_main.xml NavigationView itemIconTint). -->
	<color name="nav_drawer_icon_tint">@color/colorPrimary</color>

	<!-- troublecodes.xml input field chrome, moved off hardcoded literals. -->
	<color name="input_field_background">#EEEEEE</color>
	<color name="input_field_stroke">#CCCCCC</color>
	<color name="troublecode_text">#1A1A1A</color>

	<color name="ic_launcher_background">@color/colorPrimaryDark</color>
</resources>
