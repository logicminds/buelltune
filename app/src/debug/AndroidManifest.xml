<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-build-only manifest overlay (R12, KD2): declares the Compose shell's
  launcher entry point. This activity exists only in debug builds - AGP
  merges this file into the debug variant's manifest and it never reaches
  `app/src/main/AndroidManifest.xml` or a release build - so it adds no
  reachable component, launcher icon, or exported surface to a release APK
  (R12: "reachable only from a debug-only entry point"). `MainActivity` and
  every other entry in the main manifest are untouched.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <activity
            android:name="biz.logicminds.buelltune.ui.BuellTuneDebugActivity"
            android:label="BuellTune Debug: Connection Status"
            android:exported="true"
            android:theme="@style/AppTheme.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
