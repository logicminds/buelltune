<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Test-only ContentProvider (FixtureDocumentProvider) standing in for a
      real document-picker provider (Google Drive, another file manager,
      etc.) so U11's #12/#7 SAF regression-lock tests
      (EEPROMFragmentSafInstrumentedTest) can hand EEPROMFragment a
      genuine foreign content:// URI - the exact shape ACTION_OPEN_DOCUMENT
      / ACTION_CREATE_DOCUMENT return in production. Declared only here,
      in androidTest's own manifest, so it never ships inside the
      debug/release app APK.
    -->
    <application>
        <provider
            android:name="biz.logicminds.buelltune.fragments.FixtureDocumentProvider"
            android:authorities="biz.logicminds.buelltune.androidtest.fixtures"
            android:exported="true" />
    </application>
</manifest>
